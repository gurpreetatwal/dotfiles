gmc() {
  local -a files
  while IFS= read -r -d '' line; do
    local xy="${line:0:2}"
    local file="${line:3}"
    if [[ "$xy" =~ ^(UU|AA|AU|UA)$ ]]; then
      files+=("$file")
    fi
  done < <(git status --short -z)
  vim "${files[@]}"
}

