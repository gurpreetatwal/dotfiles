#!/usr/bin/env bash

# A safer rm: show everything that matched, confirm once, then hand the batch
# to `gomi`, which moves it to a trash it can restore from. Replaces the
# `ls <pattern>` / `rm <pattern>` dance without `rm -i`'s per-file prompt tax.
#
# Portability: this runs on Linux and macOS, so external commands use short
# flags. BSD userland has no long-flag spelling for `du -sh` and friends, which
# is why this file is exempt from the long-form rule in CLAUDE.md.

set -euo pipefail

GOMI_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/gomi/config.yaml"
HOME_TRASH="${XDG_DATA_HOME:-$HOME/.local/share}/Trash"
MY_UID="$(id -u)"
RETENTION_DAYS="${DEL_RETENTION_DAYS:-30}"

if [[ -t 1 ]]; then
  bold=$'\e[1m' red=$'\e[1;31m' cyan=$'\e[1;36m' reset=$'\e[0m'
else
  bold='' red='' cyan='' reset=''
fi

die() {
  printf '%sdel:%s %s\n' "$red" "$reset" "$1" >&2
  exit 1
}

plural() {
  [[ "$1" -eq 1 ]] && printf 'item' || printf 'items'
}

# GNU and BSD date share no relative-date syntax; try each.
days_ago() {
  date -d "$1 days ago" '+%Y-%m-%dT%H:%M:%S' 2> /dev/null ||
    date -v-"$1"d '+%Y-%m-%dT%H:%M:%S'
}

# GNU stat and BSD stat spell "device number" differently, and to GNU `stat -f`
# means something else entirely, so choose once rather than try each.
if stat -c %d / > /dev/null 2>&1; then
  device_of() { stat -c %d -- "$1"; }
else
  device_of() { stat -f %d -- "$1"; }
fi

# The mounts gomi searches for a volume trash. It skips pseudo and in-memory
# filesystems and anything read-only, so del does too: a trash gomi ignores is
# one it will refuse to use, after del has already asked for confirmation.
# DEL_TRASH_VOLUMES, newline separated, narrows the result further; the test
# suite sets it so it never sees a real volume.
mount_points() {
  local skip='^(proc|sysfs|devtmpfs|devpts|tmpfs|cgroup|cgroup2|pstore|securityfs|debugfs|configfs|fusectl|bpf|nsfs|efivarfs|hugetlbfs|mqueue|binfmt_misc)$'
  {
    if [[ -r /proc/self/mounts ]]; then
      awk -v skip="$skip" '$3 !~ skip && ("," $4 ",") !~ /,ro,/ {gsub(/\\040/, " ", $2); print $2}' /proc/self/mounts
    else
      mount | sed -nE '/[(, ]read-only[,)]/d; s/^.* on (.*) \(([^,)]*).*$/\2\t\1/p' |
        awk -F'\t' -v skip="$skip" '$1 !~ skip {print $2}'
    fi
  } | awk '!seen[$0]++' | {
    if [[ -n "${DEL_TRASH_VOLUMES+set}" ]]; then
      grep -Fx -f <(printf '%s\n' "$DEL_TRASH_VOLUMES") || true
    else
      cat
    fi
  }
}

# Every trash gomi would use: the home trash, plus `.Trash/$uid` or
# `.Trash-$uid` at the top of a mount, but only one that already exists and is
# not a symlink. gomi never creates a volume trash, so neither does del.
trash_dirs() {
  local mount trash
  printf '%s\t%s\n' "$HOME_TRASH" ""
  while IFS= read -r mount; do
    for trash in "${mount%/}/.Trash/$MY_UID" "${mount%/}/.Trash-$MY_UID"; do
      if [[ -d "$trash" && ! -L "$trash" ]]; then
        printf '%s\t%s\n' "$trash" "${mount%/}"
        break
      fi
    done
  done < <(mount_points)
}

# The trash gomi would put $1 in: the home trash when it shares a device,
# otherwise a volume trash on the same device. Nothing means gomi would refuse,
# since home_fallback is off and it never copies across devices.
trash_for() {
  local device root
  device="$(device_of "$1")" || return 1
  while IFS=$'\t' read -r root _; do
    [[ -d "$root" ]] || root="$(dirname -- "$root")"
    if [[ "$(device_of "$root")" == "$device" ]]; then
      printf '%s\n' "$root"
      return 0
    fi
  done < <(trash_dirs)
  return 1
}

# One line per trashed item: deletion date, original path, trashed file, and
# its .trashinfo. Entries whose date does not parse are reported and skipped:
# an empty date sorts before every cutoff and would read as ancient.
trash_entries() {
  local root mount info name path when
  while IFS=$'\t' read -r root mount; do
    [[ -d "$root/info" ]] || continue
    for info in "$root"/info/*.trashinfo; do
      [[ -e "$info" ]] || continue
      name="$(basename -- "$info" .trashinfo)"
      path="$(sed -n 's/^Path=//p' "$info" | head -n 1)"
      when="$(sed -n 's/^DeletionDate=//p' "$info" | head -n 1)"

      if [[ ! "$when" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
        printf '%sdel:%s skipping %s, unreadable DeletionDate\n' "$red" "$reset" "$info" >&2
        continue
      fi

      path="$(printf '%b' "${path//%/\\x}")"
      [[ "$path" == /* ]] || path="$mount/$path"
      printf '%s\t%s\t%s\t%s\n' "$when" "$path" "$root/files/$name" "$info"
    done
  done < <(trash_dirs)
}

aged_entries() {
  local cutoff
  cutoff="$(days_ago "$RETENTION_DAYS")"
  trash_entries | awk -F'\t' -v cutoff="$cutoff" '$1 < cutoff'
}

# --purge is the one path that destroys data rather than moving it, so it lists
# what would go and asks first, then deletes exactly those rows and nothing it
# did not print. It never delegates to `gomi --prune`, which would act on every
# volume's trash by its own reckoning.
purge() {
  local listing count when from file info reply
  listing="$(aged_entries)"

  if [[ -z "$listing" ]]; then
    printf 'nothing in the trash over %s days old\n' "$RETENTION_DAYS"
    return 0
  fi

  while IFS=$'\t' read -r when from _ _; do
    printf '  %s  %s\n' "${when%%T*}" "$from"
  done <<< "$listing"

  count="$(printf '%s\n' "$listing" | wc -l | tr -d ' ')"
  printf '%s%s %s in the trash over %s days old%s\n' \
    "$bold" "$count" "$(plural "$count")" "$RETENTION_DAYS" "$reset"

  [[ "$dry_run" == false ]] || return 0

  if [[ "$force" == false ]]; then
    { : < /dev/tty; } 2> /dev/null || die "no terminal to confirm on, pass --force"
    read -r -p "Permanently delete these? [y/N] " reply < /dev/tty
    [[ "$reply" == [yY]* ]] || die "aborted"
  fi

  while IFS=$'\t' read -r _ _ file info; do
    [[ "$file" == */files/?* && "$info" == */info/?*.trashinfo ]] ||
      die "refusing to delete outside a trash: $file"
    rm -rf -- "$file"
    rm -f -- "$info"
  done <<< "$listing"
}

# Report only. Emptying the trash is always something you ask for, so an
# unattended `del` can never be the reason something is gone for good.
retention_notice() {
  local count
  count="$(aged_entries 2> /dev/null | wc -l | tr -d ' ')"
  [[ "${count:-0}" -gt 0 ]] || return 0
  printf '%s%s %s in the trash over %s days old, run: del --purge%s\n' \
    "$cyan" "$count" "$(plural "$count")" "$RETENTION_DAYS" "$reset"
}

usage() {
  cat <<'EOF'
Usage: del [options] <path>...

Lists everything that matched, asks once, then moves it to the trash.

Options:
  -n, --dry-run     list what would be deleted, then exit
      --force       delete without asking for confirmation
      --permanent   unlink outright instead of trashing
      --purge [N]   list items trashed over N days ago, then delete for good
  -h, --help        show this message

Recover with `undel`, which opens gomi's restore browser.

Nothing is ever removed from the trash automatically. Once a day del reports
how much has aged past 30 days; $DEL_RETENTION_DAYS changes the window.
EOF
}

force=false
dry_run=false
permanent=false
purge_only=false
paths=()

# `rm *` hands del every name in the directory, so a file called --force or
# --permanent would otherwise switch that mode on. Options must come before the
# first path, and an option that is also the name of a file is refused.
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -?* && "$1" != "--" ]] && [[ -e "$1" || -L "$1" ]]; then
    die "'$1' is both an option and a file here; to delete the file, put it after --"
  fi

  case "$1" in
    -h|--help) usage; exit 0 ;;
    -n|--dry-run) dry_run=true ;;
    --force) force=true ;;
    --permanent) permanent=true ;;
    --purge)
      purge_only=true
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
        RETENTION_DAYS="$2"
        shift
      fi
      ;;
    # rm's own flags are accepted so muscle memory works, but they deliberately
    # do not skip the prompt: `rm -rf` is the habit that most needs one
    -[rRiIvdfF]*|--recursive|--verbose|--dir) ;;
    --) shift; break ;;
    -?*) die "unknown option: $1" ;;
    *) break ;;
  esac
  shift
done
paths=("$@")

# With a trailing slash, a symlink to a directory resolves to the directory:
# `rm -rf link/` empties the target, and the preview measured the target too.
# del acts on the name it is given, never on what that name points at.
if [[ ${#paths[@]} -gt 0 ]]; then
  for i in "${!paths[@]}"; do
    while [[ "${paths[$i]}" == */ && "${paths[$i]}" != / ]]; do
      paths[i]="${paths[$i]%/}"
    done
  done
fi

if [[ "$purge_only" == true ]]; then
  # --purge empties aged trash and touches nothing else, so a path given with
  # it can only be a mistake, and silently ignoring it would purge everything.
  [[ ${#paths[@]} -eq 0 ]] || die "--purge takes no paths; to delete ${paths[0]}, drop --purge"
  [[ "$permanent" == false ]] || die "--purge and --permanent cannot be combined"
  purge
  exit 0
fi

if [[ ${#paths[@]} -eq 0 ]]; then
  usage >&2
  exit 1
fi

if [[ "$permanent" == false && "$dry_run" == false ]] && ! command -v gomi > /dev/null; then
  die "gomi not found, run \`make gomi\` or pass --permanent"
fi

# Directories that may not be deleted themselves, though anything inside them
# may. gomi's forbidden_paths cannot express this: it protects everything below.
PROTECTED_NAMES=(
  / /dev /home /media /mnt /opt /private /tmp /Users /Volumes
  "$HOME" "$HOME/temp" "$HOME/projects"
)

# gomi.yaml's forbidden_paths are subtrees nothing inside of may be deleted.
# gomi enforces them on direct calls; del reads the same list, and stops at
# anything in it that it does not plainly understand: a list read halfway
# protects less than the file says, and nothing would show it.
protected_trees=()

expand_entry() {
  local entry="$1" out="" name value
  while [[ "$entry" =~ \$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*) ]]; do
    name="${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
    case "$name" in
      XDG_DATA_HOME) value="${XDG_DATA_HOME:-$HOME/.local/share}" ;;
      XDG_CONFIG_HOME) value="${XDG_CONFIG_HOME:-$HOME/.config}" ;;
      *) value="$(printenv -- "$name" || true)" ;;
    esac
    [[ -n "$value" ]] || return 1
    out+="${entry%%"${BASH_REMATCH[0]}"*}$value"
    entry="${entry#*"${BASH_REMATCH[0]}"}"
  done
  printf '%s\n' "$out$entry"
}

read_protected_trees() {
  local line n=0 keys=0 in_list=false key_indent=0 entry where
  [[ -r "$GOMI_CONFIG" ]] || die "cannot read $GOMI_CONFIG, refusing to run"

  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    where="$GOMI_CONFIG line $n"

    if [[ "$line" =~ ^([[:space:]]*)forbidden_paths:(.*)$ ]]; then
      keys=$((keys + 1))
      key_indent="${#BASH_REMATCH[1]}"
      [[ "${BASH_REMATCH[2]}" =~ ^[[:space:]]*(#.*)?$ ]] ||
        die "$where: forbidden_paths must be a block list, one '- path' per line"
      in_list=true
      continue
    fi

    [[ "$in_list" == true ]] || continue
    [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue

    if [[ "$line" =~ ^([[:space:]]*)-[[:space:]]+(.*)$ ]]; then
      [[ "${#BASH_REMATCH[1]}" -ge "$key_indent" ]] || die "$where: list item outside forbidden_paths"
      entry="${BASH_REMATCH[2]}"
      if [[ "$entry" =~ ^\"([^\"]*)\"[[:space:]]*(#.*)?$ || "$entry" =~ ^\'([^\']*)\'[[:space:]]*(#.*)?$ ]]; then
        entry="${BASH_REMATCH[1]}"
      else
        entry="${entry%%[[:space:]]#*}"
        entry="${entry%"${entry##*[![:space:]]}"}"
      fi

      entry="$(expand_entry "$entry")" || die "$where: uses an unset variable: $entry"
      while [[ "$entry" == */ && "$entry" != / ]]; do entry="${entry%/}"; done
      [[ "$entry" == /* ]] || die "$where: forbidden path must be absolute: $entry"
      protected_trees+=("$entry")
      continue
    fi

    line="${line%%[![:space:]]*}"
    if [[ "${#line}" -le "$key_indent" ]]; then
      in_list=false
      continue
    fi
    die "$where: cannot read this line inside forbidden_paths"
  done < "$GOMI_CONFIG"

  [[ "$keys" -eq 1 ]] || die "$GOMI_CONFIG has $keys forbidden_paths keys, expected one; refusing to run"
  [[ ${#protected_trees[@]} -gt 0 ]] || die "no forbidden_paths found in $GOMI_CONFIG, refusing to run"
}

read_protected_trees

# Lexical cleanup the way Go's filepath.Clean does it: collapse //, drop . and
# apply .. without consulting the filesystem.
clean_path() {
  local part
  local -a parts out=()
  IFS=/ read -r -a parts <<< "$1"
  for part in ${parts[@]+"${parts[@]}"}; do
    case "$part" in
      '' | .) ;;
      ..) [[ ${#out[@]} -eq 0 ]] || out=("${out[@]:0:${#out[@]}-1}") ;;
      *) out+=("$part") ;;
    esac
  done
  local IFS=/
  printf '/%s\n' "${out[*]-}"
}

# Absolute path with the directory's symlinks resolved but not the final
# component, so `del <symlink>` is judged as the link. Stands in for
# `realpath --no-symlinks`, which macOS lacks.
resolve() {
  local dir base
  [[ "$1" == "/" ]] && { printf '/\n'; return; }

  base="$(basename -- "$1")"
  if [[ "$base" == "." || "$base" == ".." ]]; then
    (cd -- "$1" && pwd -P)
    return
  fi

  dir="$(cd -- "$(dirname -- "$1")" && pwd -P)"
  [[ "$dir" == "/" ]] && printf '/%s\n' "$base" || printf '%s/%s\n' "$dir" "$base"
}

# A path as typed (made absolute and cleaned) and as it really resolves. A
# protected directory has to be recognised however it is reached: through a
# symlinked parent, by its physical path, or as `.` from inside it.
path_forms() {
  local path="$1"
  [[ "$path" == /* ]] || path="$PWD/$path"
  clean_path "$path"
  resolve "$1"
}

# A guard as written, plus fully resolved when it exists.
guard_forms() {
  clean_path "$1"
  if [[ -d "$1" ]]; then
    (cd -- "$1" 2> /dev/null && pwd -P) || true
  fi
}

within() {
  [[ "$1" == "$2" || "$1" == "${2%/}/"* ]]
}

strictly_within() {
  [[ "$1" == "${2%/}/"?* ]]
}

name_forms=()
for guard in "${PROTECTED_NAMES[@]}"; do
  while IFS= read -r form; do name_forms+=("$form"); done < <(guard_forms "$guard")
done

tree_forms=()
tree_labels=()
for guard in "${protected_trees[@]}"; do
  while IFS= read -r form; do
    tree_forms+=("$form")
    tree_labels+=("$guard")
  done < <(guard_forms "$guard")
done

# Every mount point, of any type, is protected by name, and the trash at its
# top as a subtree: otherwise `del --permanent /mnt/nvme` would empty a whole
# volume, and a volume's trash could be emptied without --purge's preview.
# Mount points come from the kernel already resolved, so they are used as they
# are; resolving them would `cd` into autofs mounts and trigger them.
all_mounts() {
  if [[ -r /proc/self/mounts ]]; then
    awk '{gsub(/\\040/, " ", $2); print $2}' /proc/self/mounts
  else
    mount | sed -nE 's/^.* on (.*) \([^)]*\)$/\1/p'
  fi | awk '!seen[$0]++'
}

while IFS= read -r mount; do
  name_forms+=("$mount")
  for trash in "${mount%/}/.Trash" "${mount%/}/.Trash-$MY_UID"; do
    tree_forms+=("$trash")
    tree_labels+=("$trash")
  done
done < <(all_mounts)

tmp_forms=()
if [[ -n "${TMPDIR:-}" ]]; then
  while IFS= read -r form; do tmp_forms+=("$form"); done < <(guard_forms "${TMPDIR%/}")
fi

# Why a path may not be deleted; nothing when it may.
protection_of() {
  local form target i exempt
  local -a targets=()
  while IFS= read -r form; do targets+=("$form"); done < <(path_forms "$1")

  for target in "${targets[@]}"; do
    for form in "${name_forms[@]}"; do
      if [[ "$target" == "$form" ]]; then
        printf 'protected directory %s' "$form"
        return 0
      fi
    done

    for i in "${!tree_forms[@]}"; do
      within "$target" "${tree_forms[$i]}" || continue

      # macOS keeps $TMPDIR under /var/folders. Protecting /var is meant for
      # the system, not for what mktemp creates there; $TMPDIR itself, and any
      # protected path inside it, stay protected. This mirrors gomi 1.6.5.
      exempt=false
      for form in ${tmp_forms[@]+"${tmp_forms[@]}"}; do
        if strictly_within "$target" "$form" && strictly_within "$form" "${tree_forms[$i]}"; then
          exempt=true
        fi
      done
      [[ "$exempt" == true ]] && continue

      printf 'inside protected %s' "${tree_labels[$i]}"
      return 0
    done
  done
  return 1
}

# Checked up front, so one bad path in a batch stops everything rather than
# leaving half a glob deleted. gomi on its own would take the rest.
for path in "${paths[@]}"; do
  [[ -e "$path" || -L "$path" ]] || die "no such file or directory: $path"
  if reason="$(protection_of "$path")"; then
    die "refusing to delete $path: $reason"
  fi

  # gomi refuses a file whose volume has no trash, but only once it reaches it,
  # after moving everything earlier in the batch. Find that out first.
  if [[ "$permanent" == false && ! -L "$path" ]] && ! trash_for "$(resolve "$path")" > /dev/null; then
    mount="$(df -P -- "$path" | awk 'NR == 2 {print $NF}')"
    die "no trash on the volume holding $path; use --permanent, or create one with: mkdir -m 700 '${mount%/}/.Trash-$MY_UID'"
  fi
done

describe() {
  local path="$1" size items

  if [[ -L "$path" ]]; then
    printf '  %6s  %s -> %s' "link" "$path" "$(readlink -- "$path")"
    [[ "$permanent" == true ]] && printf '\n' || printf '  (removed, links are not trashed)\n'
    return
  fi

  size="$(du -sh -- "$path" 2> /dev/null | cut -f1)"
  if [[ -d "$path" ]]; then
    items="$(find "$path" -mindepth 1 2> /dev/null | wc -l | tr -d ' ')"
    printf '  %6s  %s%s/%s  (%s %s)\n' "$size" "$cyan" "$path" "$reset" "$items" "$(plural "$items")"
  else
    printf '  %6s  %s\n' "$size" "$path"
  fi
}

for path in "${paths[@]}"; do
  describe "$path"
done

# Kilobytes, not bytes: `du -k` is portable where --block-size is not, and it
# keeps the threshold comparison in shell integers.
kb="$(du -sck -- "${paths[@]}" 2> /dev/null | tail -n 1 | cut -f1)"
kb="${kb:-0}"
total="$(du -sch -- "${paths[@]}" 2> /dev/null | tail -n 1 | cut -f1)"
printf '%s%s %s, %s%s\n' "$bold" "${#paths[@]}" "$(plural "${#paths[@]}")" "${total:-0}" "$reset"

if [[ "$dry_run" == true ]]; then
  exit 0
fi

# Trashing is a rename, so the space is not reclaimed until the trash is
# emptied. Large deletions are usually build output nobody restores.
if [[ "$permanent" == false && "$kb" -gt "${DEL_WARN_KB:-1048576}" ]]; then
  printf '%sthis stays on disk until the trash is emptied, --permanent frees it now%s\n' "$red" "$reset"
fi

if [[ "$force" == false ]]; then
  if [[ "$permanent" == true ]]; then
    prompt="Permanently delete? [y/N] "
  else
    prompt="Move to trash? [y/N] "
  fi
  { : < /dev/tty; } 2> /dev/null || die "no terminal to confirm on, pass --force"
  read -r -p "$prompt" reply < /dev/tty
  [[ "$reply" == [yY]* ]] || die "aborted"
fi

if [[ "$permanent" == true ]]; then
  rm -rf -- "${paths[@]}"
  exit 0
fi

# gomi routes a symlink by its target's device and records it against the wrong
# volume, so links are removed directly; the preview showed where each pointed.
# Everything else goes by its physical path, which keeps gomi's recorded path
# inside the volume it was trashed on.
links=()
items=()
for path in "${paths[@]}"; do
  if [[ -L "$path" ]]; then
    links+=("$path")
  else
    items+=("$(resolve "$path")")
  fi
done
[[ ${#items[@]} -eq 0 ]] || gomi -- "${items[@]}"
[[ ${#links[@]} -eq 0 ]] || rm -f -- "${links[@]}"

stamp="${XDG_STATE_HOME:-$HOME/.local/state}/del/last-notice"
if [[ ! -e "$stamp" ]] || [[ -n "$(find "$stamp" -mtime +0 2> /dev/null)" ]]; then
  mkdir -p "$(dirname "$stamp")"
  retention_notice
  touch "$stamp"
fi
