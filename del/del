#!/usr/bin/env bash

# A safer rm: show everything that matched, confirm once, then hand the batch
# to `gomi`, which moves it to a trash it can restore from. Replaces the
# `ls <pattern>` / `rm <pattern>` dance without `rm -i`'s per-file prompt tax.
#
# Portability: this runs on Linux and macOS, so external commands use short
# flags. BSD userland has no long-flag spelling for `du -sh` and friends, which
# is why this file is exempt from the long-form rule in CLAUDE.md.

set -euo pipefail

GOMI_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/gomi/config.yaml"
RETENTION_DAYS="${DEL_RETENTION_DAYS:-30}"

if [[ -t 1 ]]; then
  bold=$'\e[1m' red=$'\e[1;31m' cyan=$'\e[1;36m' reset=$'\e[0m'
else
  bold='' red='' cyan='' reset=''
fi

die() {
  printf '%sdel:%s %s\n' "$red" "$reset" "$1" >&2
  exit 1
}

plural() {
  [[ "$1" -eq 1 ]] && printf 'item' || printf 'items'
}

# GNU and BSD date share no relative-date syntax; try each.
days_ago() {
  date -d "$1 days ago" '+%Y-%m-%dT%H:%M:%S' 2> /dev/null ||
    date -v-"$1"d '+%Y-%m-%dT%H:%M:%S'
}

config_value() {
  local value
  value="$(awk -F': *' -v key="$1" \
    '$0 ~ "^[[:space:]]*" key ":" {print $2; exit}' "$GOMI_CONFIG" 2> /dev/null)"
  value="${value//\$XDG_DATA_HOME/${XDG_DATA_HOME:-$HOME/.local/share}}"
  printf '%s\n' "${value//\$HOME/$HOME}"
}

# --purge is the one path that destroys data rather than moving it, so it shows
# what would go and asks first, exactly like a deletion. Trusting the flag on
# its own once turned `--dry-run --purge` into an unconfirmed permanent delete.
purge() {
  local history cutoff listing count when from reply
  command -v jq > /dev/null || die "purge needs jq to list what would be removed"

  history="$(config_value gomi_dir)/history.json"
  test -r "$history" || die "cannot read $history"

  cutoff="$(days_ago "$RETENTION_DAYS")"
  listing="$(jq -r --arg cutoff "$cutoff" \
    '.files[] | select(.timestamp < $cutoff) | "\(.timestamp[0:10])\t\(.from)"' \
    "$history")"

  if [[ -z "$listing" ]]; then
    printf 'nothing in the trash over %s days old\n' "$RETENTION_DAYS"
    return 0
  fi

  while IFS=$'\t' read -r when from; do
    printf '  %s  %s\n' "$when" "$from"
  done <<< "$listing"

  count="$(printf '%s\n' "$listing" | wc -l | tr -d ' ')"
  printf '%s%s %s in the trash over %s days old%s\n' \
    "$bold" "$count" "$(plural "$count")" "$RETENTION_DAYS" "$reset"

  [[ "$dry_run" == false ]] || return 0

  if [[ "$force" == false ]]; then
    { : < /dev/tty; } 2> /dev/null || die "no terminal to confirm on, pass --force"
    read -r -p "Permanently delete these? [y/N] " reply < /dev/tty
    [[ "$reply" == [yY]* ]] || die "aborted"
  fi

  gomi --prune="${RETENTION_DAYS}d" --force
}

# Report only. Emptying the trash is always something you ask for, so an
# unattended `del` can never be the reason something is gone for good.
retention_notice() {
  local history cutoff count
  command -v jq > /dev/null || return 0

  history="$(config_value gomi_dir)/history.json"
  test -r "$history" || return 0

  cutoff="$(days_ago "$RETENTION_DAYS")"
  count="$(jq --arg cutoff "$cutoff" \
    '[.files[] | select(.timestamp < $cutoff)] | length' "$history" 2> /dev/null)" || return 0

  [[ "${count:-0}" -gt 0 ]] || return 0
  printf '%s%s %s in the trash over %s days old, run: del --purge%s\n' \
    "$cyan" "$count" "$(plural "$count")" "$RETENTION_DAYS" "$reset"
}

usage() {
  cat <<'EOF'
Usage: del [options] <path>...

Lists everything that matched, asks once, then moves it to the trash.

Options:
  -n, --dry-run     list what would be deleted, then exit
      --force       delete without asking for confirmation
      --permanent   unlink outright instead of trashing
      --purge [N]   list items trashed over N days ago, then delete for good
  -h, --help        show this message

Recover with `undel`, which opens gomi's restore browser.

Nothing is ever removed from the trash automatically. Once a day del reports
how much has aged past 30 days; $DEL_RETENTION_DAYS changes the window.
EOF
}

force=false
dry_run=false
permanent=false
purge_only=false
paths=()

# `rm *` hands del every name in the directory, so a file called --force or
# --permanent would otherwise switch that mode on. Options must come before the
# first path, and an option that is also the name of a file is refused.
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -?* && "$1" != "--" ]] && [[ -e "$1" || -L "$1" ]]; then
    die "'$1' is both an option and a file here; to delete the file, put it after --"
  fi

  case "$1" in
    -h|--help) usage; exit 0 ;;
    -n|--dry-run) dry_run=true ;;
    --force) force=true ;;
    --permanent) permanent=true ;;
    --purge)
      purge_only=true
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
        RETENTION_DAYS="$2"
        shift
      fi
      ;;
    # rm's own flags are accepted so muscle memory works, but they deliberately
    # do not skip the prompt: `rm -rf` is the habit that most needs one
    -[rRiIvdfF]*|--recursive|--verbose|--dir) ;;
    --) shift; break ;;
    -?*) die "unknown option: $1" ;;
    *) break ;;
  esac
  shift
done
paths=("$@")

# With a trailing slash, a symlink to a directory resolves to the directory:
# `rm -rf link/` empties the target, and the preview measured the target too.
# del acts on the name it is given, never on what that name points at.
if [[ ${#paths[@]} -gt 0 ]]; then
  for i in "${!paths[@]}"; do
    while [[ "${paths[$i]}" == */ && "${paths[$i]}" != / ]]; do
      paths[i]="${paths[$i]%/}"
    done
  done
fi

if [[ "$purge_only" == true ]]; then
  purge
  exit 0
fi

if [[ ${#paths[@]} -eq 0 ]]; then
  usage >&2
  exit 1
fi

if [[ "$permanent" == false && "$dry_run" == false ]] && ! command -v gomi > /dev/null; then
  die "gomi not found, run \`make gomi\` or pass --permanent"
fi

# gomi.yaml owns the protected list. Read it rather than keeping a second copy
# here, and refuse to run if it cannot be read: a silent fallback would drift
# out of sync with what gomi itself enforces.
protected=()
while IFS= read -r guard; do
  guard="${guard//\$XDG_DATA_HOME/${XDG_DATA_HOME:-$HOME/.local/share}}"
  guard="${guard//\$HOME/$HOME}"
  protected+=("$guard")
done < <(awk '/forbidden_paths:/ {found = 1; next}
              found && /^[[:space:]]*-[[:space:]]/ {sub(/^[[:space:]]*-[[:space:]]*/, ""); print; next}
              found {exit}' "$GOMI_CONFIG" 2> /dev/null)

if [[ ${#protected[@]} -eq 0 ]]; then
  die "no forbidden_paths found in $GOMI_CONFIG, refusing to run"
fi

# Absolute path without resolving the final component, so `del <symlink>`
# removes the link. Stands in for `realpath --no-symlinks`, which macOS lacks.
# gomi compares the literal argument instead, which a relative path walks past.
resolve() {
  local dir base
  [[ "$1" == "/" ]] && { printf '/\n'; return; }

  base="$(basename -- "$1")"
  if [[ "$base" == "." || "$base" == ".." ]]; then
    (cd -- "$1" && pwd -P)
    return
  fi

  dir="$(cd -- "$(dirname -- "$1")" && pwd -P)"
  [[ "$dir" == "/" ]] && printf '/%s\n' "$base" || printf '%s/%s\n' "$dir" "$base"
}

is_protected() {
  local guard
  for guard in "${protected[@]}"; do
    [[ "$1" == "$guard" ]] && return 0
  done
  return 1
}

# Checked up front, so one bad path in a batch stops everything rather than
# leaving half a glob deleted. gomi on its own would take the rest.
for path in "${paths[@]}"; do
  [[ -e "$path" || -L "$path" ]] || die "no such file or directory: $path"
  is_protected "$(resolve "$path")" &&
    die "refusing to delete protected path: $path"
done

describe() {
  local path="$1" size items

  if [[ -L "$path" ]]; then
    printf '  %6s  %s -> %s\n' "link" "$path" "$(readlink -- "$path")"
    return
  fi

  size="$(du -sh -- "$path" 2> /dev/null | cut -f1)"
  if [[ -d "$path" ]]; then
    items="$(find "$path" -mindepth 1 2> /dev/null | wc -l | tr -d ' ')"
    printf '  %6s  %s%s/%s  (%s %s)\n' "$size" "$cyan" "$path" "$reset" "$items" "$(plural "$items")"
  else
    printf '  %6s  %s\n' "$size" "$path"
  fi
}

for path in "${paths[@]}"; do
  describe "$path"
done

# Kilobytes, not bytes: `du -k` is portable where --block-size is not, and it
# keeps the threshold comparison in shell integers.
kb="$(du -sck -- "${paths[@]}" 2> /dev/null | tail -n 1 | cut -f1)"
kb="${kb:-0}"
total="$(du -sch -- "${paths[@]}" 2> /dev/null | tail -n 1 | cut -f1)"
printf '%s%s %s, %s%s\n' "$bold" "${#paths[@]}" "$(plural "${#paths[@]}")" "${total:-0}" "$reset"

if [[ "$dry_run" == true ]]; then
  exit 0
fi

# Trashing is a rename, so the space is not reclaimed until the trash is
# emptied. Large deletions are usually build output nobody restores.
if [[ "$permanent" == false && "$kb" -gt "${DEL_WARN_KB:-1048576}" ]]; then
  printf '%sthis stays on disk until the trash is emptied, --permanent frees it now%s\n' "$red" "$reset"
fi

if [[ "$force" == false ]]; then
  if [[ "$permanent" == true ]]; then
    prompt="Permanently delete? [y/N] "
  else
    prompt="Move to trash? [y/N] "
  fi
  { : < /dev/tty; } 2> /dev/null || die "no terminal to confirm on, pass --force"
  read -r -p "$prompt" reply < /dev/tty
  [[ "$reply" == [yY]* ]] || die "aborted"
fi

if [[ "$permanent" == true ]]; then
  rm -rf -- "${paths[@]}"
  exit 0
fi

gomi -- "${paths[@]}"

stamp="${XDG_STATE_HOME:-$HOME/.local/state}/del/last-notice"
if [[ ! -e "$stamp" ]] || [[ -n "$(find "$stamp" -mtime +0 2> /dev/null)" ]]; then
  mkdir -p "$(dirname "$stamp")"
  retention_notice
  touch "$stamp"
fi
