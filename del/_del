#compdef del

_arguments -s -S \
  '(-n --dry-run)'{-n,--dry-run}'[list what would be deleted, then exit]' \
  '--force[delete without asking for confirmation]' \
  '(--purge)--permanent[unlink outright instead of trashing]' \
  '(--permanent *)--purge[list items trashed over N days ago, then delete for good]:days:(7 30 90)' \
  '(- *)'{-h,--help}'[show this message]' \
  '*:path:_files'
