#!/usr/bin/env bash

# Regression tests for del. Every case runs against a throwaway HOME and XDG
# tree, and the real trash locations are fingerprinted before and after the run
# so a test that escapes the sandbox fails loudly instead of eating real data.

set -uo pipefail

here="$(cd -- "$(dirname -- "$0")" && pwd -P)"
DEL="${DEL_UNDER_TEST:-$here/del}"

REAL_HOME="$HOME"
SHM_TRASH="/dev/shm/.Trash-$(id -u)"
real_trash_fingerprint() {
  local dir
  for dir in "$REAL_HOME/.local/share/gomi" "$REAL_HOME/.local/share/Trash" /mnt/*/.Trash-"$(id -u)" "$SHM_TRASH"; do
    [[ -d "$dir" ]] || continue
    printf '%s %s\n' "$dir" "$(find "$dir" 2> /dev/null | wc -l | tr -d ' ')"
  done
}
fingerprint_before="$(real_trash_fingerprint)"

root="$(mktemp -d)"
root="$(cd -- "$root" && pwd -P)"
# A volume trash a test created for itself, removed again before the
# fingerprint check. Tests never use a volume that already has a trash.
vt_mount=""
vt_dir=""
vt_work=()
cleanup_volume() {
  [[ -z "$vt_dir" ]] || rm -rf -- "$vt_dir"
  [[ ${#vt_work[@]} -eq 0 ]] || rm -rf -- "${vt_work[@]}"
  vt_mount=""
  vt_dir=""
  vt_work=()
}
trap 'cleanup_volume; chmod -R u+w "$root" 2> /dev/null; rm -rf -- "$root"' EXIT

export HOME="$root/home"
export XDG_CONFIG_HOME="$root/config"
export XDG_DATA_HOME="$root/data"
export XDG_STATE_HOME="$root/state"
mkdir -p "$HOME/temp" "$HOME/.ssh" "$HOME/dotfiles" "$root/nvme/projects" \
  "$XDG_CONFIG_HOME/gomi" "$XDG_DATA_HOME/gomi" "$XDG_STATE_HOME"
# Like the real machine, ~/projects is a symlink onto another volume's directory.
ln -s "$root/nvme/projects" "$HOME/projects"
cp "$here/gomi.yaml" "$XDG_CONFIG_HOME/gomi/config.yaml"

# No real volume trash is ever visible to del under test.
export DEL_TRASH_VOLUMES=""

passed=0
failed=0

# Records the outcome of whatever ran immediately before it:
#   [[ -e a ]]; verdict "a still exists"
verdict() {
  local result=$?
  if [[ $result -eq 0 ]]; then
    passed=$((passed + 1))
    printf '  ok    %s\n' "$1"
  else
    failed=$((failed + 1))
    printf '  FAIL  %s\n' "$1"
    printf '%s\n' "${out:-}" | sed 's/^/        /'
  fi
}

# A fresh working directory per case, inside the sandbox.
workdir() {
  local dir
  dir="$(mktemp -d "$root/work.XXXXXX")"
  cd -- "$dir" || exit 1
}

# Run del with no terminal attached, capturing status and output.
run() {
  out="$("$DEL" "$@" < /dev/null 2>&1)"
  status=$?
}

# Run del with a pseudo-terminal that answers the prompt.
answer() {
  local reply="$1"
  shift
  out="$(printf '%s\n' "$reply" | script -qec "$(printf '%q ' "$DEL" "$@")" /dev/null 2>&1)"
  status=$?
}

skip() { printf '  skip  %s (%s)\n' "$1" "$2"; }

# Each sandbox .trashinfo, as "<original path>\t<info file>".
trash_records() {
  local info path
  for info in "$XDG_DATA_HOME"/Trash/info/*.trashinfo ${vt_dir:+"$vt_dir"/info/*.trashinfo}; do
    [[ -e "$info" ]] || continue
    path="$(sed -n 's/^Path=//p' "$info")"
    path="$(printf '%b' "${path//%/\\x}")"
    [[ "$path" == /* ]] || path="$vt_mount/$path"
    printf '%s\t%s\n' "$path" "$info"
  done
}

trashed() {
  trash_records | cut -f1 | grep -qxF -- "$1"
}

# backdate <original path> <days>: pretend it was trashed that long ago.
backdate() {
  local info when
  info="$(trash_records | awk -F'\t' -v f="$1" '$1 == f {print $2}')"
  when="$(date -d "$2 days ago" '+%Y-%m-%dT%H:%M:%S')"
  sed -i "s/^DeletionDate=.*/DeletionDate=$when/" "$info"
}

# use_volume <mount>: a writable mount on another device from the sandbox
# that has no trash yet. Creates its trash and a work dir, both removed by
# cleanup_volume. Refuses any volume that already has a trash.
use_volume() {
  local mount="$1" trash
  trash="$1/.Trash-$(id -u)"
  [[ -d "$mount" && -w "$mount" && ! -e "$trash" ]] || return 1
  [[ "$(stat -c %d "$mount")" != "$(stat -c %d "$root")" ]] || return 1
  mkdir -m 700 "$trash" "$trash/files" "$trash/info" || return 1
  vt_mount="$mount"
  vt_dir="$trash"
  vt_workdir
}

vt_workdir() {
  vol_work="$(mktemp -d "${vt_mount:-/dev/shm}/del-test.XXXXXX")"
  vt_work+=("$vol_work")
}

case_dry_run_deletes_nothing() {
  workdir; touch a b
  run -n a b
  [[ $status -eq 0 && -e a && -e b ]]; verdict "dry run lists without deleting"
}

case_missing_path_aborts_batch() {
  workdir; touch a b
  run --force a missing b
  [[ $status -ne 0 && -e a && -e b ]]; verdict "a missing path aborts the whole batch"
}

case_protected_paths_refused() {
  workdir
  run -n "$HOME"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses \$HOME"
  run -n /
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses /"
  cd -- "$HOME/temp" && run -n .
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses . inside a protected dir"
}

case_no_terminal_refuses() {
  workdir; touch a
  run a
  [[ $status -ne 0 && -e a ]]; verdict "refuses without a terminal to confirm on"
}

case_rm_flags_do_not_skip_prompt() {
  workdir; touch a
  run -rf a
  [[ $status -ne 0 && -e a ]]; verdict "-rf does not skip the prompt"
}

case_prompt_answers() {
  workdir; touch a b
  answer n a
  [[ -e a ]]; verdict "answering n keeps the file"
  answer y b
  [[ ! -e b ]] && trashed "$PWD/b"; verdict "answering y moves the file to the trash"
}

case_force_trashes() {
  workdir; touch a
  run --force a
  [[ $status -eq 0 && ! -e a ]] && trashed "$PWD/a"; verdict "--force trashes without asking"
}

case_purge_dry_run_deletes_nothing() {
  workdir; touch a
  run --force a
  run --dry-run --purge 0
  trashed "$PWD/a"; verdict "--dry-run --purge deletes nothing"
}

case_option_named_file_does_not_force() {
  workdir; touch a b; touch -- --force
  # shellcheck disable=SC2035  # reproducing exactly what an unguarded rm * passes
  run *
  [[ -e a && -e b ]]; verdict "a file named --force does not skip the prompt for *"
}

case_option_named_file_does_not_go_permanent() {
  workdir; touch keep1 keep2; touch -- --permanent --force
  # shellcheck disable=SC2035
  run *
  [[ -e keep1 && -e keep2 ]]; verdict "files named --permanent and --force do not unlink *"
}

case_option_named_file_does_not_purge() {
  workdir; touch old; run --force old
  touch x; touch -- --purge
  # shellcheck disable=SC2035
  run *
  [[ $status -ne 0 && -e x ]] && trashed "$PWD/old"
  verdict "a file named --purge does not turn * into a purge"
}

case_options_after_a_path_are_paths() {
  workdir; touch a
  run a --force
  [[ $status -ne 0 && -e a ]]; verdict "an option after a path is treated as a path"
}

case_double_dash_deletes_option_named_file() {
  workdir; touch -- --force
  answer y -- --force
  [[ ! -e --force ]] && trashed "$PWD/--force"; verdict "-- deletes a file named like an option"
  touch -- --force
  run --force -- --force
  [[ $status -ne 0 && -e --force ]]; verdict "an option that names a file here is refused as ambiguous"
}

case_permanent_symlink_slash_keeps_target() {
  workdir; mkdir target; touch target/a target/b; ln -s target link
  run --permanent --force link/
  [[ ! -L link && -e target/a && -e target/b ]]
  verdict "--permanent link/ removes the link and leaves the target's contents"
}

case_trash_symlink_slash_keeps_target() {
  workdir; mkdir target; touch target/a; ln -s target link
  run --force link/
  [[ ! -L link && -e target/a ]]; verdict "link/ trashes the link, not the target"
}

case_symlink_to_protected_dir() {
  workdir; touch "$HOME/projects/work"; ln -s "$HOME/projects" p
  run --permanent --force p/
  [[ -e "$HOME/projects/work" ]]; verdict "--permanent through a link to a protected dir leaves it intact"
}

case_preview_describes_the_link() {
  workdir; mkdir target; touch target/a target/b target/c; ln -s target link
  run -n link/
  [[ "$out" == *"->"* && "$out" != *"3 items"* ]]
  verdict "the preview shows the link, not the target's size and contents"
}

case_subtree_contents_refused() {
  workdir; touch "$HOME/.ssh/id_ed25519" "$HOME/dotfiles/vimrc" "$XDG_DATA_HOME/gomi/history.json"
  run -n "$HOME/.ssh/id_ed25519"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses a file inside ~/.ssh"
  run -n "$HOME/dotfiles/vimrc"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses a file inside ~/dotfiles"
  run -n "$XDG_DATA_HOME/gomi/history.json"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses the trash's own index"
}

case_subtree_through_symlinked_parent() {
  workdir; touch "$HOME/.ssh/key"; ln -s "$HOME/.ssh" sshlink
  run -n sshlink/key
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses a protected subtree reached through a symlink"
}

case_exact_dir_by_physical_path() {
  cd -- "$root/nvme/projects" && run -n .
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses ~/projects reached by its physical path"
  cd -- "$HOME/projects" && run -n .
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses ~/projects as . from inside it"
  touch "$HOME/projects/scratch"
  run -n "$HOME/projects/scratch"
  [[ $status -eq 0 ]]; verdict "allows a file inside ~/projects"
}

case_opt_is_exact() {
  if [[ ! -d /opt ]]; then skip "refuses /opt itself" "no /opt here"; return; fi
  workdir
  run -n /opt
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses /opt itself"
}

case_tmpdir_inside_subtree_is_allowed() {
  mkdir -p "$root/fakevar/folders/T"
  with_guard "$root/fakevar"
  touch "$root/fakevar/folders/T/scratch" "$root/fakevar/other"
  TMPDIR="$root/fakevar/folders/T" run -n "$root/fakevar/folders/T/scratch"
  [[ $status -eq 0 ]]; verdict "allows files in \$TMPDIR under a protected subtree, as on macOS"
  TMPDIR="$root/fakevar/folders/T" run -n "$root/fakevar/other"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "still refuses the rest of that subtree"
  TMPDIR="$root/fakevar/folders/T" run -n "$root/fakevar/folders/T"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "still refuses \$TMPDIR itself"
  reset_config
}

# with_guard <dir>: make <dir> a protected subtree for the rest of the case.
with_guard() {
  sed -i "s|^\( *\)forbidden_paths:\$|&\n\1  - $1|" "$XDG_CONFIG_HOME/gomi/config.yaml"
}

reset_config() {
  cp "$here/gomi.yaml" "$XDG_CONFIG_HOME/gomi/config.yaml"
}

case_gomi_is_the_pinned_version() {
  local pinned installed
  pinned="$(sed -n 's/^flags\/gomi: version ?= //p' "$here/../Makefile")"
  installed="$(gomi --version 2> /dev/null | sed -n 's/^version: v//p')"
  out="pinned $pinned, installed $installed"
  [[ -n "$pinned" && "$pinned" == "$installed" ]]; verdict "the installed gomi is the version the Makefile pins"
}

case_gomi_refuses_relative_path_into_subtree() {
  mkdir -p "$root/guarded/sub"; touch "$root/guarded/sub/f"; with_guard "$root/guarded"
  out="$(cd -- "$root/guarded" && gomi sub/f 2>&1)"
  [[ -e "$root/guarded/sub/f" ]]; verdict "gomi itself refuses a relative path into a protected subtree"
  touch "$root/guarded/sub/f"
  out="$(gomi "$root/guarded/sub/f" 2>&1)"
  [[ -e "$root/guarded/sub/f" ]]; verdict "gomi itself refuses an absolute path into a protected subtree"
  reset_config
}

case_gomi_allows_tmpdir_under_subtree() {
  mkdir -p "$root/gvar/folders/T"; touch "$root/gvar/folders/T/scratch"; with_guard "$root/gvar"
  out="$(TMPDIR="$root/gvar/folders/T" gomi "$root/gvar/folders/T/scratch" 2>&1)"
  [[ ! -e "$root/gvar/folders/T/scratch" ]]; verdict "gomi allows \$TMPDIR contents under a protected subtree"
  reset_config
}

case_purge_deletes_exactly_what_it_listed() {
  workdir; touch old1 old2 fresh
  run --force old1 old2 fresh
  backdate "$PWD/old1" 40; backdate "$PWD/old2" 40
  run -n --purge 30
  local listed="$out"
  run --force --purge 30
  ! trashed "$PWD/old1" && ! trashed "$PWD/old2" && trashed "$PWD/fresh" &&
    [[ "$listed" == *old1* && "$listed" == *old2* && "$listed" != *fresh* ]] &&
    [[ ! -e "$XDG_DATA_HOME/Trash/files/old1" && ! -e "$XDG_DATA_HOME/Trash/files/old2" ]]
  verdict "--purge deletes exactly the entries it listed, data and record"
}

case_purge_skips_undated_entries() {
  workdir; touch a
  run --force a
  sed -i 's/^DeletionDate=.*/DeletionDate=/' "$(trash_records | awk -F'\t' -v f="$PWD/a" '$1 == f {print $2}')"
  run --force --purge 0
  trashed "$PWD/a" && [[ "$out" == *unreadable* ]]
  verdict "an entry without a readable date is never purged"
}

case_retention_notice_counts_aged() {
  workdir; touch old new
  run --force old
  backdate "$PWD/old" 40
  rm -rf -- "$XDG_STATE_HOME/del"
  run --force new
  [[ "$out" == *"1 item in the trash over 30 days old"* ]]
  verdict "the notice counts items past the window"
}

case_symlink_is_unlinked_not_trashed() {
  workdir; mkdir t; touch t/a; ln -s t l
  run --force l
  [[ ! -L l && -e t/a ]] && ! trashed "$PWD/l"
  verdict "a symlink is removed, not trashed, and its target is untouched"
}

case_trashed_path_is_physical() {
  touch "$HOME/projects/via-link"
  run --force "$HOME/projects/via-link"
  trashed "$root/nvme/projects/via-link"
  verdict "a file reached through a symlinked directory is recorded by its physical path"
}

case_no_volume_trash_refuses_before_moving() {
  if [[ ! -w /dev/shm ]]; then skip "a volume without a trash refuses the whole batch" "no /dev/shm"; return; fi
  vt_workdir; touch "$vol_work/f"
  workdir; touch local
  DEL_TRASH_VOLUMES=/dev/shm run --force local "$vol_work/f"
  [[ $status -ne 0 && -e local && -e "$vol_work/f" ]] && ! trashed "$PWD/local"
  verdict "a volume without a usable trash refuses the whole batch before moving anything"
  cleanup_volume
}

case_tmpfs_trash_is_ignored() {
  if ! use_volume /dev/shm; then skip "a trash on tmpfs is ignored, as gomi ignores it" "no spare /dev/shm"; return; fi
  touch "$vol_work/f"
  workdir; touch local
  DEL_TRASH_VOLUMES=/dev/shm run --force local "$vol_work/f"
  [[ $status -ne 0 && -e local && -e "$vol_work/f" && "$out" == *"no trash on the volume"* ]] &&
    ! trashed "$PWD/local"
  verdict "a trash on tmpfs is ignored, as gomi ignores it, before anything in the batch moves"
  cleanup_volume
}

# Needs a spare writable volume that is not tmpfs; CI makes one. Set
# DEL_TEST_VOLUME to its mount point to run this locally.
case_volume_trash_renames_in_place() {
  if [[ -z "${DEL_TEST_VOLUME:-}" ]] || ! use_volume "$DEL_TEST_VOLUME"; then
    skip "a file on another volume is renamed into that volume's trash" "set DEL_TEST_VOLUME to a spare volume"
    return
  fi
  touch "$vol_work/g"
  local inode; inode="$(stat -c %i "$vol_work/g")"
  DEL_TRASH_VOLUMES="$DEL_TEST_VOLUME" run --force "$vol_work/g"
  [[ $status -eq 0 && "$(stat -c %i "$vt_dir/files/g" 2> /dev/null)" == "$inode" ]] &&
    trashed "$vol_work/g" && [[ ! -e "$XDG_DATA_HOME/Trash/files/g" ]]
  verdict "a file on another volume is renamed into that volume's trash, not copied"
  cleanup_volume
}

# DEL_TEST_CASES=<regex> runs only matching cases. Each case gets its own trash
# and state, so one case's leftovers cannot satisfy or break another's checks.
for case in $(declare -F | awk '{print $3}' | grep '^case_' | grep -E -- "${DEL_TEST_CASES:-.}"); do
  export XDG_DATA_HOME="$root/data/$case" XDG_STATE_HOME="$root/state/$case"
  mkdir -p "$XDG_DATA_HOME/gomi" "$XDG_STATE_HOME"
  "$case"
done

cd /
cleanup_volume
fingerprint_after="$(real_trash_fingerprint)"
if [[ "$fingerprint_before" != "$fingerprint_after" ]]; then
  printf '\nREAL TRASH CHANGED DURING TESTS\nbefore:\n%s\nafter:\n%s\n' "$fingerprint_before" "$fingerprint_after"
  exit 2
fi

printf '\n%s passed, %s failed\n' "$passed" "$failed"
[[ $failed -eq 0 ]]
