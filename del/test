#!/usr/bin/env bash

# Regression tests for del. Every case runs against a throwaway HOME and XDG
# tree, and the real trash locations are fingerprinted before and after the run
# so a test that escapes the sandbox fails loudly instead of eating real data.

set -uo pipefail

here="$(cd -- "$(dirname -- "$0")" && pwd -P)"
DEL="${DEL_UNDER_TEST:-$here/del}"

REAL_HOME="$HOME"
real_trash_fingerprint() {
  local dir
  for dir in "$REAL_HOME/.local/share/gomi" "$REAL_HOME/.local/share/Trash" /mnt/*/.Trash-"$(id -u)"; do
    [[ -d "$dir" ]] || continue
    printf '%s %s\n' "$dir" "$(find "$dir" 2> /dev/null | wc -l | tr -d ' ')"
  done
}
fingerprint_before="$(real_trash_fingerprint)"

root="$(mktemp -d)"
root="$(cd -- "$root" && pwd -P)"
trap 'chmod -R u+w "$root" 2> /dev/null; rm -rf -- "$root"' EXIT

export HOME="$root/home"
export XDG_CONFIG_HOME="$root/config"
export XDG_DATA_HOME="$root/data"
export XDG_STATE_HOME="$root/state"
mkdir -p "$HOME/temp" "$HOME/.ssh" "$HOME/dotfiles" "$root/nvme/projects" \
  "$XDG_CONFIG_HOME/gomi" "$XDG_DATA_HOME/gomi" "$XDG_STATE_HOME"
# Like the real machine, ~/projects is a symlink onto another volume's directory.
ln -s "$root/nvme/projects" "$HOME/projects"
cp "$here/gomi.yaml" "$XDG_CONFIG_HOME/gomi/config.yaml"

passed=0
failed=0

# Records the outcome of whatever ran immediately before it:
#   [[ -e a ]]; verdict "a still exists"
verdict() {
  local result=$?
  if [[ $result -eq 0 ]]; then
    passed=$((passed + 1))
    printf '  ok    %s\n' "$1"
  else
    failed=$((failed + 1))
    printf '  FAIL  %s\n' "$1"
    printf '%s\n' "${out:-}" | sed 's/^/        /'
  fi
}

# A fresh working directory per case, inside the sandbox.
workdir() {
  local dir
  dir="$(mktemp -d "$root/work.XXXXXX")"
  cd -- "$dir" || exit 1
}

# Run del with no terminal attached, capturing status and output.
run() {
  out="$("$DEL" "$@" < /dev/null 2>&1)"
  status=$?
}

# Run del with a pseudo-terminal that answers the prompt.
answer() {
  local reply="$1"
  shift
  out="$(printf '%s\n' "$reply" | script -qec "$(printf '%q ' "$DEL" "$@")" /dev/null 2>&1)"
  status=$?
}

trashed() {
  [[ -e "$XDG_DATA_HOME/gomi/history.json" ]] &&
    jq -e --arg f "$1" 'any((.files // [])[]; .from == $f)' "$XDG_DATA_HOME/gomi/history.json" > /dev/null
}

case_dry_run_deletes_nothing() {
  workdir; touch a b
  run -n a b
  [[ $status -eq 0 && -e a && -e b ]]; verdict "dry run lists without deleting"
}

case_missing_path_aborts_batch() {
  workdir; touch a b
  run --force a missing b
  [[ $status -ne 0 && -e a && -e b ]]; verdict "a missing path aborts the whole batch"
}

case_protected_paths_refused() {
  workdir
  run -n "$HOME"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses \$HOME"
  run -n /
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses /"
  cd -- "$HOME/temp" && run -n .
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses . inside a protected dir"
}

case_no_terminal_refuses() {
  workdir; touch a
  run a
  [[ $status -ne 0 && -e a ]]; verdict "refuses without a terminal to confirm on"
}

case_rm_flags_do_not_skip_prompt() {
  workdir; touch a
  run -rf a
  [[ $status -ne 0 && -e a ]]; verdict "-rf does not skip the prompt"
}

case_prompt_answers() {
  workdir; touch a b
  answer n a
  [[ -e a ]]; verdict "answering n keeps the file"
  answer y b
  [[ ! -e b ]] && trashed "$PWD/b"; verdict "answering y moves the file to the trash"
}

case_force_trashes() {
  workdir; touch a
  run --force a
  [[ $status -eq 0 && ! -e a ]] && trashed "$PWD/a"; verdict "--force trashes without asking"
}

case_purge_dry_run_deletes_nothing() {
  workdir; touch a
  run --force a
  run --dry-run --purge 0
  trashed "$PWD/a"; verdict "--dry-run --purge deletes nothing"
}

case_option_named_file_does_not_force() {
  workdir; touch a b; touch -- --force
  # shellcheck disable=SC2035  # reproducing exactly what an unguarded rm * passes
  run *
  [[ -e a && -e b ]]; verdict "a file named --force does not skip the prompt for *"
}

case_option_named_file_does_not_go_permanent() {
  workdir; touch keep1 keep2; touch -- --permanent --force
  # shellcheck disable=SC2035
  run *
  [[ -e keep1 && -e keep2 ]]; verdict "files named --permanent and --force do not unlink *"
}

case_option_named_file_does_not_purge() {
  workdir; touch old; run --force old
  touch x; touch -- --purge
  # shellcheck disable=SC2035
  run *
  [[ $status -ne 0 && -e x ]] && trashed "$PWD/old"
  verdict "a file named --purge does not turn * into a purge"
}

case_options_after_a_path_are_paths() {
  workdir; touch a
  run a --force
  [[ $status -ne 0 && -e a ]]; verdict "an option after a path is treated as a path"
}

case_double_dash_deletes_option_named_file() {
  workdir; touch -- --force
  answer y -- --force
  [[ ! -e --force ]] && trashed "$PWD/--force"; verdict "-- deletes a file named like an option"
  touch -- --force
  run --force -- --force
  [[ $status -ne 0 && -e --force ]]; verdict "an option that names a file here is refused as ambiguous"
}

case_permanent_symlink_slash_keeps_target() {
  workdir; mkdir target; touch target/a target/b; ln -s target link
  run --permanent --force link/
  [[ ! -L link && -e target/a && -e target/b ]]
  verdict "--permanent link/ removes the link and leaves the target's contents"
}

case_trash_symlink_slash_keeps_target() {
  workdir; mkdir target; touch target/a; ln -s target link
  run --force link/
  [[ ! -L link && -e target/a ]]; verdict "link/ trashes the link, not the target"
}

case_symlink_to_protected_dir() {
  workdir; touch "$HOME/projects/work"; ln -s "$HOME/projects" p
  run --permanent --force p/
  [[ -e "$HOME/projects/work" ]]; verdict "--permanent through a link to a protected dir leaves it intact"
}

case_preview_describes_the_link() {
  workdir; mkdir target; touch target/a target/b target/c; ln -s target link
  run -n link/
  [[ "$out" == *"->"* && "$out" != *"3 items"* ]]
  verdict "the preview shows the link, not the target's size and contents"
}

case_subtree_contents_refused() {
  workdir; touch "$HOME/.ssh/id_ed25519" "$HOME/dotfiles/vimrc" "$XDG_DATA_HOME/gomi/history.json"
  run -n "$HOME/.ssh/id_ed25519"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses a file inside ~/.ssh"
  run -n "$HOME/dotfiles/vimrc"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses a file inside ~/dotfiles"
  run -n "$XDG_DATA_HOME/gomi/history.json"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses the trash's own index"
}

case_subtree_through_symlinked_parent() {
  workdir; touch "$HOME/.ssh/key"; ln -s "$HOME/.ssh" sshlink
  run -n sshlink/key
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses a protected subtree reached through a symlink"
}

case_exact_dir_by_physical_path() {
  cd -- "$root/nvme/projects" && run -n .
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses ~/projects reached by its physical path"
  cd -- "$HOME/projects" && run -n .
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses ~/projects as . from inside it"
  touch "$HOME/projects/scratch"
  run -n "$HOME/projects/scratch"
  [[ $status -eq 0 ]]; verdict "allows a file inside ~/projects"
}

case_opt_is_exact() {
  if [[ ! -d /opt ]]; then skip "refuses /opt itself" "no /opt here"; return; fi
  workdir
  run -n /opt
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "refuses /opt itself"
}

case_tmpdir_inside_subtree_is_allowed() {
  mkdir -p "$root/fakevar/folders/T"
  sed -i "s|^\( *\)forbidden_paths:\$|&\n\1  - $root/fakevar|" "$XDG_CONFIG_HOME/gomi/config.yaml"
  touch "$root/fakevar/folders/T/scratch" "$root/fakevar/other"
  TMPDIR="$root/fakevar/folders/T" run -n "$root/fakevar/folders/T/scratch"
  [[ $status -eq 0 ]]; verdict "allows files in \$TMPDIR under a protected subtree, as on macOS"
  TMPDIR="$root/fakevar/folders/T" run -n "$root/fakevar/other"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "still refuses the rest of that subtree"
  TMPDIR="$root/fakevar/folders/T" run -n "$root/fakevar/folders/T"
  [[ $status -ne 0 && "$out" == *refusing* ]]; verdict "still refuses \$TMPDIR itself"
  cp "$here/gomi.yaml" "$XDG_CONFIG_HOME/gomi/config.yaml"
}

for case in $(declare -F | awk '{print $3}' | grep '^case_'); do
  "$case"
done

cd /
fingerprint_after="$(real_trash_fingerprint)"
if [[ "$fingerprint_before" != "$fingerprint_after" ]]; then
  printf '\nREAL TRASH CHANGED DURING TESTS\nbefore:\n%s\nafter:\n%s\n' "$fingerprint_before" "$fingerprint_after"
  exit 2
fi

printf '\n%s passed, %s failed\n' "$passed" "$failed"
[[ $failed -eq 0 ]]
