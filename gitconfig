[user]
	email=git@gatwal.com
	name=Gurpreet Atwal
[core]
	editor=vim
	excludesfile=~/.config/git/ignore
[push]
	default=current
	autoSetupRemote = true
[branch]
	autosetuprebase=always
[merge]
	tool = nvimdiff
[diff]
	tool = nvimdiff
[advice]
	pushNonFastForward = false
	resolveConflict = false
	statusHints = false
[help]
	autocorrect=5
[rerere]
	enabled = true
[commit]
	gpgsign = false
[init]
	defaultBranch = main
[mergetool]
	keepBackup = false
	hideResolved = true
[mergetool "vimdiff"]
	layout = LOCAL,REMOTE / MERGED
