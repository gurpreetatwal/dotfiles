[user]
	email=git@gatwal.com
	name=Gurpreet Atwal
[core]
	; no editor= on purpose: shell/profile already picks nvim or vim, and git
	; falls back to $EDITOR then vi, so there is nothing to keep in sync here
	excludesfile=~/.config/git/ignore
[push]
	default=simple
	autoSetupRemote = true
[branch]
	autosetuprebase=always
[rebase]
	; rebasing the top of a stack also moves every branch stacked beneath it
	updateRefs = true
[merge]
	tool = nvimdiff
[diff]
	tool = nvimdiff
[advice]
	pushNonFastForward = false
	resolveConflict = false
	statusHints = false
[help]
	autocorrect=5
[rerere]
	enabled = true
[commit]
	gpgsign = false
[init]
	defaultBranch = main
[mergetool]
	keepBackup = false
	hideResolved = true
[mergetool "vimdiff"]
	layout = LOCAL,REMOTE / MERGED
